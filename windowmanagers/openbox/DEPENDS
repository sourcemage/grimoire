depends  xorg-libs    &&
depends  fontconfig   &&
depends  glib2        &&
depends  libxml2      &&
depends  -sub "X" pango  &&
depends  libxfixes    &&
depends  libx11       &&
depends  libxext      &&
depends  libxau       &&
depends  libxft       &&
depends  freetype2    &&
depends  harfbuzz     &&

optional_depends  libxcursor                          \
                  "--enable-xcursor"                  \
                  "--disable-xcursor"                 \
                  "for Xcursor extension support"     &&

optional_depends  libxrandr                           \
                  "--enable-xrandr"                   \
                  "--disable-xrandr"                  \
                  "for xrandr support"                &&

optional_depends  libxinerama                         \
                  "--enable-xinerama"                 \
                  "--disable-xinerama"                \
                  "for X11 Xinerama extension support" &&

optional_depends  libsm                               \
                  "--enable-session-management"       \
                  "--disable-session-management"      \
                  "for session management support"    &&

if is_depends_enabled $SPELL libsm; then
  depends  libice
fi &&

optional_depends  startup-notification                \
                  "--enable-startup-notification"     \
                  "--disable-startup-notification"    \
                  "for startup notification support"
