           SPELL=mandoc
         VERSION=1.14.6
          SOURCE=$SPELL-$VERSION.tar.gz
     SOURCE_HASH=sha512:54286070812a47b629f68757046d3c9a1bdd2b5d1c3b84a5c8e4cb92f1331afa745443f7238175835d8cfbe5b8dd442e00c75c3a5b5b8f8efd8d2ec8f636dad4
SOURCE_DIRECTORY="$BUILD_DIRECTORY/$SPELL-$VERSION"
        WEB_SITE=https://mandoc.bsd.lv/
   SOURCE_URL[0]=$WEB_SITE/snapshots/$SOURCE
      LICENSE[0]=ISC
         ENTERED=20261005
        KEYWORDS="man doc"
           SHORT="manpage compiler and manual page viewer"
cat << EOF
Unix manpage compiler. This package provides the man command, the apropos,
whatis and makewhatis helpers, and the mandoc, demandoc and soelim
formatters. mandoc compiles the mdoc and man macro languages to terminal,
HTML and markdown output with a built-in formatter, so unlike man and man-db
it needs no roff implementation such as groff at build or run time.
EOF
