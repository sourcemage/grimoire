. "${GRIMOIRE}/MESON_FUNCTIONS"
           SPELL=zathura
         VERSION=2026.07.18
     SOURCE_HASH=sha256:9efc4a92f8b2d03e5a1b80756d3ae4249d8d6efdb10e311795e8cdd8e35a9f87:UPSTREAM_HASH
          SOURCE=$SPELL-$VERSION.tar.xz
   SOURCE_URL[0]=https://pwmt.org/projects/$SPELL/download/$SOURCE
 SOURCE_HINTS[0]="no-check-certificate"
SOURCE_DIRECTORY="$BUILD_DIRECTORY/$SPELL-$VERSION"
        DOC_DIRS=""
        WEB_SITE=http://pwmt.org/projects/zathura
         ENTERED=20100725
      LICENSE[0]=ZLIB
           SHORT="PDF viewer"
cat << EOF
zathura is a highly customizable and functional PDF viewer based on the poppler
rendering library and the gtk+ toolkit. The idea behind zathura is
an application that provides a minimalistic and space saving interface as well
as an easy usage that mainly focuses on keyboard interaction.
EOF
