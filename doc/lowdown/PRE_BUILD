default_pre_build &&
cd "$SOURCE_DIRECTORY" &&
# configure reads the environment from configure.local only, and that file
# overrides the command line as well; spells have no $PREFIX to expand,
# hence the literal /usr paths below
cat > configure.local << EOF_LOCAL
CC="${CC:-gcc}"
CFLAGS="${CFLAGS}"
LDFLAGS="${LDFLAGS}"
PREFIX="/usr"
MANDIR="/usr/share/man"
EOF_LOCAL