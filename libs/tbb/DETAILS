           SPELL=tbb
         VERSION=2023.1.0
     SOURCE_HASH=sha512:c8e9b9100873d6f8514da18ca700165466a9c042d24a6ce9e8901c8996c348f2e58f0251b1eca47d33cc5f382783bfc7693bc6c451716540d4caa57339b3b535
          SOURCE=$SPELL-$VERSION.tar.gz
