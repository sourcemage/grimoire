. "${GRIMOIRE}/FUNCTIONS"
. "${GRIMOIRE}/CMAKE_FUNCTIONS"
           SPELL=mesa-libclc
if [[ "${MESA_LIBCLC_BRANCH}" == "scm" ]]; then
         VERSION="$(get_scm_version)"
          SOURCE="${SPELL}-scm.tar.xz"
   SOURCE_URL[0]="git_http://gitlab.freedesktop.org/karolherbst/${SPELL}:${SPELL}-scm"
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELL}-scm"
   SOURCE_IGNORE="volatile"
  FORCE_DOWNLOAD="on"
else
         VERSION="22.1.8.3"
     SOURCE_HASH="sha512:a9b5e41d95d03c74a5f3563e9ee81ce95bbe88a3c6fb28478becfe13662aad5cbf42ed1e05c3337af72850ce4128e56514f7ebeee379bcd6d0769d77030cebd3"
          SOURCE="${SPELL}-${VERSION}.tar.bz2"
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELL}-${VERSION}"
   SOURCE_URL[0]="https://gitlab.freedesktop.org/karolherbst/${SPELL}/-/archive/${VERSION}/${SOURCE}"
fi
        WEB_SITE=zhttps://gitlab.freedesktop.org/karolherbst/mesa-libclc/
      LICENSE[0]="APACHE"
         ENTERED="20261017"
        KEYWORDS="libclc mesa opencl rusticl"
           SHORT="libclc fork for Mesa"
cat << EOF
This is a fork of LLVM's libclc applying some fixes of a known good state.
EOF
