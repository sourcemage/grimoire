source $GRIMOIRE/CMAKE_FUNCTIONS
           SPELL=libical
         VERSION=4.0.6
     SOURCE_HASH=sha512:f58a156795067d5adc1bc041e7aaa87fed1e420b62ac2c43228581d1f73ab4e87788aec9c83b3537e515c016e5cfab13bbaec958a23929f33196a6cddfe60607
          SOURCE=$SPELL-$VERSION.tar.gz
SOURCE_DIRECTORY=$BUILD_DIRECTORY/$SPELL-$VERSION
   SOURCE_URL[0]="https://github.com/$SPELL/$SPELL/releases/download/v$VERSION/$SOURCE"
      LICENSE[0]=LGPL
        KEYWORDS="libs"
        WEB_SITE=https://libical.github.io/libical/
         ENTERED=20020927
           SHORT="OSS implementation of IETF iCalendar"
cat << EOF
Libical is an Open Source implementation of the IETF's iCalendar
Calendaring and Scheduling protocols. (RFC 2445, 2446, and 2447). It
parses iCal components and provides a C API for manipulating the
component properties, parameters, and subcomponents.
EOF
