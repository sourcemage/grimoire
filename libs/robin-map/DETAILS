. "${GRIMOIRE}/CMAKE_FUNCTIONS"
           SPELL=robin-map
         VERSION=1.4.1
     SOURCE_HASH=sha512:c77dba232537e71f930a9a54f4e7575debcac10bbfa67f002a3b7262889871d146de583b774b5c8a0b5bf5a7471ee17c375bda6bb4f3f3cf52e1d33313231be2
          SOURCE="${SPELL}-${VERSION}.tar.gz"
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELL}-${VERSION}"
        WEB_SITE=https://github.com/Tessil/robin-map
   SOURCE_URL[0]=$WEB_SITE/archive/refs/tags/v$VERSION.tar.gz
      LICENSE[0]=MIT
         ENTERED=20261114
           SHORT="C++ hash map and hash set using robin hood hashing"
cat << EOF
robin-map is a header-only C++ library providing a fast hash map and hash set
that use open addressing and linear robin hood hashing with backward shift
deletion. It installs the tsl-robin-map CMake package, which OpenImageIO and
nanobind look for.
EOF
