. "$GRIMOIRE"/GO_FUNCTIONS
           SPELL=glab
         VERSION=1.114.0
          SOURCE=cli-$VERSION.tar.gz
   SOURCE_URL[0]=https://github.com/gitlabhq/cli/archive/refs/tags/v$VERSION.tar.gz
SOURCE_DIRECTORY=$BUILD_DIRECTORY/cli-$VERSION
     SOURCE_HASH=sha512:8e4d50964f5b9a8de8d7292ee1436917300b20d626478170f4c1c036f8e2dfc91b5a8240454aae68e60b0437716125c0b76cbdef2db7064d27ef55427e7f5346
        WEB_SITE=https://gitlab.com/gitlab-org/cli
      LICENSE[0]=MIT
        KEYWORDS="vcs devel"
         ENTERED=20260817
           SHORT="GitLab CLI tool"
cat << EOF
GLab is an open source GitLab CLI tool. It brings GitLab to your
terminal, next to where you are already working with git and your
code, without switching between windows and browser tabs. It can
manage issues, merge requests, CI/CD pipelines, releases, and more,
against GitLab.com, GitLab Dedicated, or GitLab Self-Managed
instances.
EOF
