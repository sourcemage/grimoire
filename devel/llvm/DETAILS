          SOURCE32="$SOURCE31.sig"
   SOURCE32_URL[0]="${SOURCE31_URL[0]}.sig"
      SOURCE31_GPG="llvm.gpg:$SOURCE32:UPSTREAM_KEY"
   SOURCE32_IGNORE="signature"
