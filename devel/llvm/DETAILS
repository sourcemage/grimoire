if [[ "$LLVM_WITH_FLANG" == y ]]; then
          SOURCE34="flang-${VERSION}.src.tar.xz"
   SOURCE34_URL[0]="${GITHUB_URI}/${SOURCE34}"
          SOURCE35="$SOURCE34.sig"
   SOURCE35_URL[0]="${SOURCE34_URL[0]}.sig"
