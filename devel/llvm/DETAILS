if [[ "$LLVM_WITH_SPIRV" == y ]]; then
          SOURCE33="SPIRV-LLVM-Translator-$SPIRV_VERSION.tar.gz"
   SOURCE33_URL[0]="https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v$SPIRV_VERSION/$SOURCE33"
     SOURCE33_HASH="$SPIRV_HASH"
