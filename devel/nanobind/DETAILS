. "${GRIMOIRE}/CMAKE_FUNCTIONS"
           SPELL=nanobind
         VERSION=3.1.0
     SOURCE_HASH=sha512:3cbf96c73323dc71bc6fc463e087857493c7711ffcb2a8f4fe2a479bd3f0268d0b3c4bab7138d87e98475ec34a5f51be273d5522cb1ec63d90a1a83badd90a75
          SOURCE="${SPELL}-${VERSION}.tar.gz"
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELL}-${VERSION}"
        WEB_SITE=https://github.com/wjakob/nanobind
   SOURCE_URL[0]=$WEB_SITE/archive/refs/tags/v$VERSION.tar.gz
      LICENSE[0]=BSD
         ENTERED=20261114
           SHORT="tiny and efficient C++/Python bindings"
cat << EOF
nanobind is a small binding library that exposes C++ types in Python and vice
versa. It is similar to pybind11 (same author), with smaller binaries and
faster compile times. It is used by OpenImageIO's Python bindings.
EOF
