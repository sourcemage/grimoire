# We need to restore the package database after resurrection.

message "${MESSAGE_COLOR}Restoring the package database...${DEFAULT_COLOR}"
GHC_VERSION=$(ghc --numeric-version)
GHC_DIR=${INSTALL_ROOT}/usr/lib/ghc-${GHC_VERSION}/lib
rm -rf ${GHC_DIR}/package.conf.d
mv -v ${GHC_DIR}/package.conf.d.bak ${GHC_DIR}/package.conf.d
ghc-pkg recache
