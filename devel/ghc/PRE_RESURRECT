# We need to backup the package database before resurrection.  Since 6.12 it
# is a directory of .conf files, not the old package.conf/package.conf.old pair.

message "${MESSAGE_COLOR}Backuping the package database...${DEFAULT_COLOR}"
GHC_VERSION=$(ghc --numeric-version)
GHC_DIR=${INSTALL_ROOT}/usr/lib/ghc-${GHC_VERSION}/lib
rm -rf ${GHC_DIR}/package.conf.d.bak
cp -av ${GHC_DIR}/package.conf.d ${GHC_DIR}/package.conf.d.bak
