. "$GRIMOIRE"/MESON_FUNCTIONS
           SPELL=hax
         VERSION=0.5.0
          SOURCE=$SPELL-$VERSION.tar.gz
   SOURCE_URL[0]=https://github.com/OleksandrChekhovskyi/hax/archive/v$VERSION.tar.gz
     SOURCE_HASH=sha512:095e646957f4bb9fcf26150f984749e041cf1b6c8e0395f111a7635732672ab66d3bb4743672bf43184f4aab9187934f3b62b35c41f6c3d6ab9980712d7e4357
SOURCE_DIRECTORY=$BUILD_DIRECTORY/$SPELL-$VERSION
        WEB_SITE=https://usehax.dev
         ENTERED=20260924
      LICENSE[0]=MIT
        KEYWORDS="ai agent coding terminal"
           SHORT="minimalist terminal-native coding agent written in C"
cat << EOF
hax is a minimalist, terminal-native coding agent written in C. It is a
single small binary that talks to OpenAI, Anthropic, OpenRouter and
compatible providers, or to local models through llama.cpp and ollama.
It keeps native terminal scrollback, uses XDG paths, and extends through
config, markdown files and subprocesses instead of a plugin runtime.
EOF
