          SOURCE="$SPELL-$REF.tar.gz"
        WEB_SITE="https://git.sr.ht/~mcf/cproc/"
   SOURCE_URL[0]="$WEB_SITE/archive/$REF.tar.gz"
     SOURCE_HASH=sha512:d0f0364b3d8e9c1e119f80788c439b4b753b1182056c74dd8c2bad20adc3e100a2237ae1fd3455c26b85816fe4e128f0cb2de3b0228d985dab2dab9bc2bc9cd6
