. "$GRIMOIRE"/QT6_DEPENDS &&
. "$GRIMOIRE"/VDEPENDS &&
optional_depends SSL \
        -DWITH_ossl_PLUGIN=yes \
        -DWITH_ossl_PLUGIN=no \
        'OpenSSL plugin' &&
optional_depends LIBSASL \
        -DWITH_cyrus-sasl_PLUGIN=yes \
        -DWITH_cyrus-sasl_PLUGIN=no \
        'Sasl2 plugin' &&
optional_depends botan \
        -DWITH_botan_PLUGIN=yes \
        -DWITH_botan_PLUGIN=no \
        'Botan plugin' &&
if is_depends_enabled $SPELL botan; then
  vdepends <<< 'botan >= 3.12.0'
fi &&
optional_depends nss \
        -DWITH_nss_PLUGIN=yes \
        -DWITH_nss_PLUGIN=no \
        'NSS plugin' &&
optional_depends GNUPG \
        -DWITH_gnupg_PLUGIN=yes \
        -DWITH_gnupg_PLUGIN=no \
        'GPG plugin' &&
optional_depends libgcrypt \
        -DWITH_gcrypt_PLUGIN=yes \
        -DWITH_gcrypt_PLUGIN=no \
        'GCrypt plugin' &&
optional_depends pkcs11-helper \
        -DWITH_pkcs11_PLUGIN=yes \
        -DWITH_pkcs11_PLUGIN=no \
        'pkcs11 plugin' &&
optional_depends ca-certificates '' '' ''
