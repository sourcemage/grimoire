. "$GRIMOIRE"/CMAKE_FUNCTIONS
           SPELL=copyq
         VERSION=16.0.0
          SOURCE="CopyQ-$VERSION.tar.gz"
   SOURCE_URL[0]="https://github.com/hluk/CopyQ/archive/v${VERSION}.tar.gz"
  SOURCE_HASH[0]="sha512:843abe18a2bcd9e2c6c7a68ed13011e465c0a606df3a3fac2ddbfacfb62b291ab3ce21ac15be8216e582ffe052f2815236e637ac35efc78031754d74e3b6f0ee"
SOURCE_DIRECTORY="$BUILD_DIRECTORY/CopyQ-$VERSION"
        WEB_SITE="https://hluk.github.io/CopyQ/"
         LICENSE="GPL-3.0-only"
        KEYWORDS="clipboard manager"
           SHORT="Advanced clipboard manager with scripting support"
cat << EOF
CopyQ is a feature-rich clipboard manager with advanced features including
scripting support, custom commands, and a powerful search interface. It
supports multiple clipboards, image and text formats, and can be extended
using JavaScript or other scripting languages. It is designed for power
users who need more control over their clipboard history.
EOF
