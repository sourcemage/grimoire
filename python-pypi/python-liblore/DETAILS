         VERSION=0.10.2
          SOURCE=liblore-$VERSION.tar.gz
     SOURCE_HASH=sha512:ed5a35cc7b084ce4f309d3edfd2d89cf9ec5f867265219cc601ca459596464437df7c290eb3da14844c92c4bc065fb96e399269a65094b29f97fb68f7c070124
   SOURCE_URL[0]=https://files.pythonhosted.org/packages/source/l/liblore/$SOURCE
SOURCE_DIRECTORY="$BUILD_DIRECTORY/liblore-$VERSION"
        WEB_SITE=https://git.kernel.org/pub/scm/utils/liblore/liblore.git
      LICENSE[0]=GPL-2.0+
         ENTERED=20261120
        KEYWORDS="python git email lore patch mailing-list"
           SHORT="Shared library for public-inbox / lore.kernel.org access"
cat << EOF
liblore is a Python library for working with public-inbox servers,
particularly lore.kernel.org. It fetches email threads, parses mbox
files, summarises patch series, and provides utilities for working
with email messages from mailing list archives. It is used by b4.
EOF
