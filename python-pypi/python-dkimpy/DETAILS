          SOURCE=dkimpy-$VERSION.tar.gz
     SOURCE_HASH=sha512:c8a53c01ab329e40ac66c1c77e40f104871fb9f52058a530d08b26599c20cd960f0f4b6a1e4be8e173332634ed0b10e0bf0711285a8eefa40ec5cfdbed74e12e
