        WEB_SITE=https://launchpad.net/dkimpy
      LICENSE[0]=zlib
         ENTERED=20261120
        KEYWORDS="python email dkim arc tlsrpt signing verification"
           SHORT="DKIM and ARC email signing and verification library"
cat << EOF
dkimpy is a Python implementation of DKIM (DomainKeys Identified Mail),
ARC (Authenticated Received Chain) and TLSRPT (TLS Report) email signing
and verification. It installs the "dkim" Python module, which tools such
as b4 import to sign and verify mail.
EOF
