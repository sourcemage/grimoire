           SPELL=python-ezgb
         VERSION=0.2.2
          SOURCE=ezgb-$VERSION.tar.gz
     SOURCE_HASH=sha512:26b1f3f918f3a61053c90fab2440f3534c8b4c51d059534182da2c3c16fd3959076661751ad5d0a8c0056ffd6feec1bd4ebfc2514d1fb961e07542adba17ff55
   SOURCE_URL[0]=https://files.pythonhosted.org/packages/source/e/ezgb/$SOURCE
SOURCE_DIRECTORY="$BUILD_DIRECTORY/ezgb-$VERSION"
        WEB_SITE=https://git.kernel.org/pub/scm/utils/ezgb/ezgb.git/
      LICENSE[0]=GPL-2.0+
         ENTERED=20261120
        KEYWORDS="python git bugs git-bug tracker"
           SHORT="Standalone Python library for git-bug repositories"
cat << EOF
ezgb is a standalone Python library for working with git-bug
repositories. It lists, creates, queries and updates bugs stored as
native git objects, without an external database. It reads bug data
directly from git objects through pygit2. b4 uses it for its bugs
interface.
EOF
