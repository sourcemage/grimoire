         VERSION=1.6.0
          SOURCE=${SPELL/-/_}-$VERSION.tar.gz
     SOURCE_HASH=sha512:e5703ff82811c24c4d5cd80125eac5c358e46d03da52141a1249c6aabdeef7f36b5deed4f071c4d453df0c37a6eb6d18db743ed3058c01741d701c575827cd95
   SOURCE_URL[0]=https://files.pythonhosted.org/packages/1f/80/a6ada19562b12ed466dac5c3e02aef5ed7c8d0881864d80e0d94d0dc71f5/$SOURCE
SOURCE_DIRECTORY=$BUILD_DIRECTORY/${SOURCE%.tar.gz}
        WEB_SITE=https://github.com/containers/podman-compose
      LICENSE[0]=GPL
         ENTERED=20261001
        KEYWORDS="containers podman docker compose"
           SHORT="run compose files with podman"
cat << EOF
An implementation of the Compose Spec with a podman backend. It reads a
compose file, converts the services it describes into podman commands and
runs them, so compose files written for docker-compose work with podman
unchanged.

The services are started by calling podman directly, so rootless and
daemon-less operation is preserved. It requires Python 3.9 or newer, PyYAML,
python-dotenv and podman itself.
EOF
