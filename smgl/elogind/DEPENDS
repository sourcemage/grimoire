. "$GRIMOIRE"/MESON_DEPENDS &&

depends DEVICE-MANAGER   &&
depends gperf   &&
#depends INIT    &&
depends libcap  &&
depends libxcrypt &&
depends perl    &&
#depends util-linux &&
depends INIT &&

optional_depends libxslt    'man=enabled' 'man=disabled' 'build man pages' &&
# the man pages are rendered with tools/meson-render-jinja2.py
if is_depends_enabled $SPELL libxslt; then
  depends jinja2
fi &&
optional_depends lxml       '' '' 'index  man pages' &&
#optional_depends intltool   '' '--disable-nls' 'NLS support' &&
#optional_depends libseccomp '' '--disable-seccomp' 'SECCOMP support' &&
optional_depends libselinux 'selinux=enabled' 'selinux=disabled' 'SELINUX support' &&
optional_depends linux-pam  'pam=enabled' 'pam=disabled' 'PAM support' &&
optional_depends acl        'acl=enabled' 'acl=disabled' 'ACL support' &&
optional_depends audit      'audit=enabled' 'audit=disabled'  'Audit support' &&
optional_depends dbus       'dbus=enabled'  'dbus=disabled'   'use Dbus'  &&
# policykit needs libelogind to build, so only offer it once policykit is
# installed, as linux-pam does for elogind
if spell_ok policykit; then
  optional_depends policykit  'polkit=enabled' 'polkit=disabled' 'PolicyKit support'
fi
