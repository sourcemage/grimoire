   SOURCE_URL[0]=https://codeberg.org/jelmer/ctrlproxy/archive/v$VERSION.tar.gz
     SOURCE_HASH=sha512:7de8b99e2b1d64054fb0814da9e39bcf918c3a6f64b9e3730c250f94e9cd2f6aa7552cfe608613711cb463759470684be8561cfc0eb4827a7a9efa5a66bf0be3
