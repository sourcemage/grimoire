depends gcc    &&
depends PKG-CONFIG &&
depends glib2  &&
depends libgcrypt &&
depends linux-pam &&
depends libxklavier &&
depends libxml2 &&
depends libxdmcp &&
depends itstool &&
depends intltool &&
depends libxcb  &&
depends perl    &&

optional_depends audit \
                 '--enable-libaudit' \
                 '--disable-libaudit' \
                 'audit logins' &&

optional_depends GETTEXT \
                 '--enable-nls' \
                 '--disable-nls' \
                 'for Native Language Support (NLS)' &&

optional_depends qtbase \
                 '--enable-liblightdm-qt5' \
                 '--disable-liblightdm-qt5' \
                 'enable LightDM client QT5 libraries' &&

optional_depends qt6base \
                 '--enable-liblightdm-qt6' \
                 '--disable-liblightdm-qt6' \
                 'enable LightDM client QT6 libraries' &&
if is_depends_enabled $SPELL qtbase || is_depends_enabled $SPELL qt6base; then
  depends -sub CXX gcc
fi &&

optional_depends gtk-doc '--enable-gtk-doc' '--disable-gtk-doc' \
                         'to build documentation' &&

optional_depends gobject-introspection \
                 '--enable-introspection=yes' \
                 '--enable-introspection=no' \
                 'for introspection support' &&

optional_depends vala \
                 '--enable-vala=yes' \
                 '--enable-vala=no' \
                 'for vala bindings'
