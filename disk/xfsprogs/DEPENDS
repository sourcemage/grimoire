depends PKG-CONFIG    &&
depends util-linux    &&
depends libtool       &&
depends inih          &&
depends userspace-rcu &&

optional_depends GETTEXT \
                 "--enable-gettext" \
                 "--disable-gettext" \
                 "for alternate language support" &&

optional_depends util-linux \
                 "--enable-blkid" \
                 "--disable-blkid" \
                 "to use block device id library" &&

optional_depends icu \
                 "--enable-libicu" \
                 "--disable-libicu" \
                 "for unicode name scrubbung" &&

optional_depends libedit \
                 --enable-editline=yes \
                 --enable-editline=no \
                 "for command editing"
