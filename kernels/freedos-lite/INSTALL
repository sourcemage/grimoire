export TZ=UTC && # pin for reliable timestamps on FAT
install -d "$INSTALL_ROOT/usr/lib/freedos" &&
mkfs.fat --invariant -F 12 -n FD14BOOT -C x86boot-lite.img 1440 &&
mcopy -m -i x86boot-lite.img -s -Q tree/* :: &&
dd if="SOURCE/KERNEL/boot/fat12com.bin" of=x86boot-lite.img \
   bs=1 skip=62 seek=62 count=450 conv=notrunc &&
install -Dt "$INSTALL_ROOT"/usr/lib/freedos/ -m644 x86boot-lite.img &&
install -Dm444 "$SOURCE_DIRECTORY/SOURCE/KERNEL/COPYING" \
    "$INSTALL_ROOT/usr/share/doc/$SPELL-$VERSION/COPYING.kernel" &&
install -Dm444 "$SOURCE_DIRECTORY/SOURCE/FREECOM/license" \
    "$INSTALL_ROOT/usr/share/doc/$SPELL-$VERSION/LICENSE.freecom"
