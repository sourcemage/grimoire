mkdir -p "$SOURCE_DIRECTORY/SOURCE" &&
cd "$SOURCE_DIRECTORY" &&
unpack_file &&
unpack_file 2 &&
mv *-FreeDOS-v$VERSION/SOURCE/* SOURCE/ &&
stamp=$(date -u -d "@$SOURCE_DATE_EPOCH" '+%b %e %Y') &&
clock=$(date -u -d "@$SOURCE_DATE_EPOCH" '+%H:%M:%S') &&
sedit "s|__DATE__|\"$stamp\"|g;s|__CLOCK__|\"$clock\"|g" \
    SOURCE/FREECOM/shell/ver.c \
    SOURCE/KERNEL/hdr/version.h \
    SOURCE/KERNEL/sys/sys.c
