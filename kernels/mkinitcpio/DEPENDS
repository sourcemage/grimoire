. "$GRIMOIRE"/MESON_DEPENDS &&
depends libarchive &&
depends busybox &&
depends asciidoc &&

optional_depends systemd \
                 systemd=enabled \
                 systemd=disabled \
                 'for systemd-based initramfs images and UKI support' &&

optional_depends gzip     '' '' 'for gzip initramfs compression' &&
optional_depends xz-utils '' '' 'for lzma/xz initramfs compression' &&
optional_depends bzip2    '' '' 'for bzip2 initramfs compression' &&
optional_depends lzop     '' '' 'for lzo initramfs compression' &&
optional_depends lz4      '' '' 'for lz4 initramfs compression' &&
optional_depends zstd     '' '' 'for zstd initramfs compression'
