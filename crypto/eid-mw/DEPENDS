depends autoconf-archive &&
depends pcsc-lite &&
depends libassuan &&
depends curl      &&
depends glib2     &&
depends SSL       &&
optional_depends gtk+3 "" "--without-gtkvers" "build viewer" &&
if is_depends_enabled $SPELL gtk+3;then
  depends libxml2 &&
  depends libproxy
fi &&
optional_depends GETTEXT '--enable-nls' '--disable-nls' 'NLS support' &&
optional_depends pinentry '--enable-pinentry' '--disable-pinentry' 'use pinentry for dialogs' &&
optional_depends p11-kit '--enable-p11kit' '--disable-p11kit' 'use p11-kit'
