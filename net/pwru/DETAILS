           SPELL=pwru
         VERSION=1.0.12
          SOURCE="${SPELL}-${VERSION}.tar.gz"
   SOURCE_URL[0]=https://github.com/cilium/${SPELL}/archive/refs/tags/v${VERSION}.tar.gz
     SOURCE_HASH=sha512:6ff002fdbd6e25dd4c462d21eff49eb6122560c5ca4083d2f08fb2b5cd130da808d48f9ba257decf17a71859a2ac8439a90d1e17276aa53b765a0d627c9f80fe
