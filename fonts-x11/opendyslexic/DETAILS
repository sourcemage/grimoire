           SPELL=opendyslexic
         VERSION=0.91.12
          SOURCE=$SPELL-$VERSION.tar.gz
   SOURCE_URL[0]=https://github.com/antijingoist/$SPELL/archive/v$VERSION.tar.gz
     SOURCE_HASH=sha512:67bfc7322bd77253ff9e40aa156af3dd8129db5a5ea52a04430edf9776f8f811b5cf54390cb8c66c79bfab66ef067ad819faf73109aab3bf3f1afefa49549950:SOURCE
SOURCE_DIRECTORY="$BUILD_DIRECTORY/$SPELL-$VERSION"
        WEB_SITE=https://opendyslexic.org/
      LICENSE[0]=OFL-1.1
         ENTERED=20260731
        KEYWORDS="font opentype accessibility"
           SHORT="typeface designed to increase readability for readers with dyslexia"
cat << EOF
OpenDyslexic is a free, open typeface that uses weighted bottoms, wide spacing
and distinct letterforms to help offset some of the common symptoms of dyslexia
(letter confusion, swapping, etc).

This spell installs the pre-compiled OpenType (.otf) files for the Regular,
Bold, Italic and Bold-Italic styles.
EOF
