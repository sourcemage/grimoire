install -Dm0755 "target/release/${SPELL}" -t "${INSTALL_ROOT}/usr/bin" &&
install -Dm0644 "assets/dev.zellij.Zellij.desktop" -t "${INSTALL_ROOT}/usr/share/applications" &&
install -Dm0644 "assets/dev.zellij.Zellij.metainfo.xml" -t "${INSTALL_ROOT}/usr/share/metainfo" &&

for size in 128 256 512; do
  install -Dm0644 "zellij-utils/assets/icons/logo${size}.png" \
                  "${INSTALL_ROOT}/usr/share/icons/hicolor/${size}x${size}/apps/dev.zellij.Zellij.png"
done &&

if is_depends_enabled "${SPELL}" "bash-completion"; then
  ./target/release/${SPELL} setup --generate-completion bash > "target/${SPELL}.bash" &&
  install -Dm0644 "target/${SPELL}.bash" "${INSTALL_ROOT}/usr/share/bash-completion/completions/${SPELL}"
fi &&

if is_depends_enabled "${SPELL}" "fish"; then
  ./target/release/${SPELL} setup --generate-completion fish > "target/${SPELL}.fish" &&
  install -Dm0644 "target/${SPELL}.fish" "${INSTALL_ROOT}/usr/share/fish/vendor_completions.d/${SPELL}.fish"
fi &&

if is_depends_enabled "${SPELL}" "zsh"; then
  ./target/release/${SPELL} setup --generate-completion zsh > "target/${SPELL}.zsh" &&
  install -Dm0644 "target/${SPELL}.zsh" "${INSTALL_ROOT}/usr/share/zsh/site-functions/_${SPELL}"
fi
