From: Ismael Luceno <ismael@sourcemage.org>
Date: Tue, 20 Oct 2026 06:57:26 +0200
Subject: [PATCH] Fix libiconv version guard

Upstream-Status: Pending
Origin: Source Mage
Signed-off-by: Ismael Luceno <ismael@sourcemage.org>
---
 libarchive/archive_version_details.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff -u a/libarchive/archive_version_details.c b/libarchive/archive_version_details.c
--- a/libarchive/archive_version_details.c
+++ b/libarchive/archive_version_details.c
@@ -476,7 +476,7 @@ archive_libiconv_version(void)
 const char *
 archive_libiconv_version(void)
 {
-#if HAVE_LIBCHARSET && HAVE_ICONV_H
+#if HAVE_LIBCHARSET && HAVE_ICONV_H && defined(_LIBICONV_VERSION)
 	char major = _libiconv_version >> 8;
 	char minor = _libiconv_version & 0xFF;
 	static char charset_version[6];
