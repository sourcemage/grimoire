source $GRIMOIRE/CMAKE_FUNCTIONS
           SPELL=openimageio
          SPELLX=OpenImageIO
         VERSION=3.2.2.0
     SOURCE_HASH=sha512:efd48e2a7fd477437d35dec1132b4e84c775bb66d1b39f64bb6337f8cf132335ecf687ee75c4ea8c04692634aadffb8ff3ff106c7abca04605c7499335f8363a
          SOURCE="${SPELLX}-${VERSION}.tar.gz"
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELLX}-${VERSION}"
        WEB_SITE="https://github.com/AcademySoftwareFoundation/OpenImageIO"
   SOURCE_URL[0]="$WEB_SITE/releases/download/v$VERSION/$SOURCE"
      LICENSE[0]=BSD
         ENTERED=20130111
           SHORT="a library for reading and writing images"
cat << EOF
OpenImageIO is a library for reading and writing images, and a bunch of
related classes, utilities, and applications.  There is a particular emphasis
on formats and functionality used in professional, large-scale animation and
visual effects work for film.  OpenImageIO is used extensively in animation
and VFX studios all over the world, and is also incorporated into several
commercial products.
EOF
