source $GRIMOIRE/CMAKE_DEPENDS &&
depends -sub CXX gcc &&
depends yaml-cpp &&
depends pystring &&
depends minizip &&
depends expat &&

depends imath &&
depends lcms2   '-DUSE_EXTERNAL_LCMS=on'    &&

optional_depends python3 \
                 '-DOCIO_BUILD_PYTHON=on' \
                 '-DOCIO_BUILD_PYTHON=off' \
                 'for python bindings' &&
if is_depends_enabled $SPELL python3; then
  depends pybind11
fi &&

# the apps (ocioconvert etc.) need an image library: OpenEXR here; without
# it, skip them (the "no" answer used to ask for OpenImageIO, which is not
# a dependency, so configure failed)
optional_depends openexr \
                 '-DOCIO_USE_OIIO_FOR_APPS=off' \
                 '-DOCIO_BUILD_APPS=off' \
                 'to build the apps (ocioconvert etc.) with OpenEXR'
