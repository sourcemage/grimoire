cd "$SOURCE_DIRECTORY/builddir" &&
default_install &&
if [[ -f "$SOURCE_DIRECTORY/linuxdeploy/WordTsar.desktop" ]]; then
  install -vm444 "$SOURCE_DIRECTORY/linuxdeploy/WordTsar.desktop" \
    -Dt "$INSTALL_ROOT/usr/share/applications"
fi &&
if [[ -f "$SOURCE_DIRECTORY/linuxdeploy/wordtsar.png" ]]; then
  install -vm444 "$SOURCE_DIRECTORY/linuxdeploy/wordtsar.png" \
    -Dt "$INSTALL_ROOT/usr/share/pixmaps"
fi
