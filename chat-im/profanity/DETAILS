. "$GRIMOIRE/FUNCTIONS"
. "${GRIMOIRE}/MESON_FUNCTIONS"
           SPELL=profanity
if [[ ${PROFANITY_BRANCH} == scm ]]; then
         VERSION=$(get_scm_version)
          SOURCE="${SPELL}-scm.tar.bz2"
   SOURCE_URL[0]="git_http://github.com/profanity-im/${SPELL}.git:${SPELL}-scm"
   SOURCE_IGNORE=volatile
  FORCE_DOWNLOAD=on
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELL}-scm"
else
         VERSION="0.19.0"
     SOURCE_HASH="sha256:fa201a10df688a173a0ce61da3be528f8e03f44d72817ed327568acb1c8fb259:UPSTREAM_HASH"
          SOURCE=${SPELL}-${VERSION}.tar.xz
   SOURCE_URL[0]="https://github.com/${SPELL}-im/${SPELL}/releases/download/${VERSION}/${SOURCE}"
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/${SPELL}-${VERSION}"
fi
        DOC_DIRS=""
        WEB_SITE=https://profanity-im.github.io/
      LICENSE[0]=GPL
         ENTERED=20131013
           SHORT="Ncurses based XMPP client"
cat << EOF
Profanity is a console based XMPP client written in C using ncurses and
libstrophe, inspired by Irssi.
EOF
