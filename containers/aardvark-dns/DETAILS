           SPELL=aardvark-dns
         VERSION=1.17.1
     SOURCE_HASH=sha512:f7100ebaa9cde032bdef7975a0486a47c178543c6c6e35a538f4fe71b2cec788f7ceaae715637fb7a7e706aa31144efbcd1002af8b1300b1faedd3fbada37781
          SOURCE=$SPELL-$VERSION.tar.gz
SOURCE_DIRECTORY="$BUILD_DIRECTORY/$SPELL-$VERSION"
   SOURCE_URL[0]=https://github.com/containers/$SPELL/archive/v$VERSION/$SOURCE
        WEB_SITE=https://github.com/containers/aardvark-dns
      LICENSE[0]=Apache-2.0
         ENTERED=20260815
        KEYWORDS="containers network dns rust"
           SHORT="authoritative DNS server for container names"
cat << EOF
Aardvark-dns is an authoritative DNS server for A/AAAA container records.  It
forwards other requests to configured resolvers.

It is a rust based DNS server, meant to be used together with netavark, and
is what lets containers on the same podman network reach each other by name.
EOF
