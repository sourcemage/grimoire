-	subUIDSlice := strings.Split(
-		strings.Trim(string(subUIDout), "\n"),
-		" ")[2:]
-
-	subGIDout, err := exec.Command("getsubids", "-g", user.Username).Output()
+	subGIDSlice, err := runGetSubIDs(user.Username, "-g", user.Username)
 	if err != nil {
