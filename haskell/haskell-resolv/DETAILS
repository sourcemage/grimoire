           SPELL=haskell-resolv
         VERSION=0.2.0.3
          SOURCE="resolv-${VERSION}.tar.gz"
   SOURCE_URL[0]=https://hackage.haskell.org/package/resolv-${VERSION}/${SOURCE}
     SOURCE_HASH=sha512:bcf624aaf08855d827e37803dedda4f50f2f219a1a0d7e957f3a7f90414d3e0356f41954ba8a969a9fb36af5b2c8c2fe797e9d1b1dfe379d5e5508be557a5ed7
SOURCE_DIRECTORY="${BUILD_DIRECTORY}/resolv-${VERSION}"
        WEB_SITE="https://hackage.haskell.org/package/resolv"
      LICENSE[0]=GPL-2.0-or-later
         ENTERED=20260817
           SHORT="Domain Name Service (DNS) lookup via the libresolv standard library routines"
cat << EOF
This package implements an API for accessing the Domain Name Service (DNS)
resolver service via the standard libresolv system library, whose API is
often available directly from the standard libc C library on Unix systems.

It also supports decoding the message record types defined in RFCs 1035,
1183, 2782, 2915, 3596, 4034, 4255, 4408, 5155, 6844, 6891 and 7553.
EOF
