           SPELL=miniaudio
         VERSION=0.11.25
          SOURCE=$SPELL-$VERSION.tar.gz
     SOURCE_HASH=sha512:8cdfe5cd66dd84628430a24026b307c21158b4776492eec234c2ce3cf0da3ae26fe8162f3ed285502f6002fdf252ccb660f7c216e044e3c306b75b0997700b45
SOURCE_DIRECTORY=$BUILD_DIRECTORY/$SPELL-$VERSION
        WEB_SITE=https://github.com/mackron/miniaudio
   SOURCE_URL[0]=$WEB_SITE/archive/refs/tags/$VERSION.tar.gz
      LICENSE[0]=PD
      LICENSE[1]=MIT
         ENTERED=20260926
        KEYWORDS="audio libs"
           SHORT="audio playback and capture library"
cat << EOF
miniaudio is an audio playback and capture library written in a single source
file with no dependencies other than the standard library. It decodes WAV, FLAC
and MP3 out of the box, and plays through PulseAudio, ALSA, JACK, sndio and the
native backends of the other supported platforms. The library is released into
the public domain, with MIT-0 as an alternative.
EOF
