. "$GRIMOIRE"/CMAKE_FUNCTIONS
           SPELL=iir1
         VERSION=1.10.0
          SOURCE=$SPELL-$VERSION.tar.gz
SOURCE_DIRECTORY=$BUILD_DIRECTORY/$SPELL-$VERSION
        WEB_SITE=https://github.com/berndporr/iir1
   SOURCE_URL[0]=$WEB_SITE/archive/refs/tags/$VERSION.tar.gz
     SOURCE_HASH=sha512:f50b925394f79662ae021c02e60667273a5d4615f2ef9f88d256c3c6dbb0f7d851207b65e2da56b69a97e576b3bb611653fde421df4ae0a952615d29be2f33a6
      LICENSE[0]=MIT
         ENTERED=20260928
        KEYWORDS="audio libs"
           SHORT="infinite impulse response filter library"
cat << EOF
iir1 is a library for designing and implementing infinite impulse response
filters as a cascade of second order sections. It provides Butterworth,
Chebyshev I, Chebyshev II and Bessel low, high, band pass, band stop and high
or low shelf filters, the classic RBJ audio equalizer cookbook filters, and
filters built from arbitrary poles and zeros.

The library is header friendly and installs a CMake package and a pkg-config
file, so it is picked up by find_package(iir) and pkg-config iir. It is used by
audio applications such as DOSBox Staging for its resampling and filtering
code paths.
EOF
