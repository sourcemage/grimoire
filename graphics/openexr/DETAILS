source $GRIMOIRE/CMAKE_FUNCTIONS
           SPELL=openexr
         VERSION=3.5.3
  SECURITY_PATCH=9
          SOURCE=$SPELL-$VERSION.tar.gz
SOURCE_DIRECTORY=$BUILD_DIRECTORY/$SPELL-$VERSION
   SOURCE_URL[0]=https://github.com/AcademySoftwareFoundation/openexr/archive/v${VERSION}.tar.gz
     SOURCE_HASH=sha512:6f0a11437d1c33cfff06d6d7c4c32c2b6660c7665e056b6506d3c078f38d7bcc23594e1695caa32f1ce1c0c018c950a282d75d0bf131966adcf768dd0a3cc1f3
        WEB_SITE=https://www.openexr.com/
         ENTERED=20030123
      LICENSE[0]=https://www.ilm.com/opensource/ilm-bsd-lic.html
        KEYWORDS="graphics"
           SHORT="High dynamic-range (HDR) image file format"
cat << EOF
OpenEXR is a high dynamic-range (HDR) image file format developed by Industrial
Light & Magic for use in computer imaging applications.

OpenEXR has already been used by ILM on 4 major motion pictures -- Harry Potter
and the Sorcerer's Stone, Men in Black II, Gangs of New York, and Signs --
and is also being used on several other movies currently in production.
EOF
